// ============================================================
// VIEWS/ALUNO/INDEX.CSHTML
// ============================================================

@model IEnumerable<NotasMVC.Models.Aluno>

<h1>Sistema de Notas</h1>

<table border="1">
<tr>
    <th>Aluno</th>
    <th>Curso</th>
    <th>Média</th>
    <th>Situação</th>
</tr>

@foreach (var a in Model)
{
<tr>
    <td>@a.Nome</td>
    <td>@a.Curso</td>
    <td>@a.Media.ToString("N2")</td>
    <td>@a.Situacao</td>
</tr>
}
</table>
