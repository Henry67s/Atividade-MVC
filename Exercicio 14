// ============================================================
// VIEWS/CURSO/INDEX.CSHTML
// ============================================================

@model IEnumerable<CursosMVC.Models.Curso>

<h1>Sistema de Cursos</h1>

<table border="1">
<tr>
    <th>Curso</th>
    <th>Carga Horária</th>
    <th>Modalidade</th>
    <th>Vagas</th>
    <th>Valor</th>
    <th>Status</th>
</tr>

@foreach (var c in Model)
{
<tr>
    <td>@c.Nome</td>
    <td>@c.CargaHoraria horas</td>
    <td>@c.Modalidade</td>
    <td>@c.Vagas</td>
    <td>R$ @c.Valor.ToString("N2")</td>
    <td>@c.Status</td>
</tr>
}
</table>

<h2>Resumo</h2>

<p>Total de cursos: @Model.Count()</p>
<p>Disponíveis: @Model.Count(x => x.Vagas > 0)</p>
<p>Lotados: @Model.Count(x => x.Vagas == 0)</p>
<p>Online: @Model.Count(x => x.Modalidade == "Online")</p>
<p>Presenciais: @Model.Count(x => x.Modalidade == "Presencial")</p>
