// ============================================================
// VIEWS/FUNCIONARIO/INDEX.CSHTML
// ============================================================

@model IEnumerable<DesafioFinalMVC.Models.Funcionario>

<h2>Funcionários</h2>

<table border="1">
<tr>
    <th>Nome</th>
    <th>Cargo</th>
    <th>Departamento</th>
    <th>Salário</th>
    <th>Status</th>
    <th>Faixa</th>
</tr>

@foreach (var f in Model)
{
<tr>
    <td>@f.Nome</td>
    <td>@f.Cargo</td>
    <td>@f.Departamento</td>
    <td>R$ @f.Salario.ToString("N2")</td>
    <td>@f.Status</td>
    <td>@f.Faixa</td>
</tr>
}
</table>


