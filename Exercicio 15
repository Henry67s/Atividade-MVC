var builder = WebApplication.CreateBuilder(args);
builder.Services.AddControllersWithViews();

var app = builder.Build();

app.UseHttpsRedirection();
app.UseStaticFiles();
app.UseRouting();

app.MapControllerRoute(
    name: "default",
    pattern: "{controller=Funcionario}/{action=Index}/{id?}");

app.Run();


// ============================================================
// MODELS/FUNCIONARIO.CS
// ============================================================

namespace DesafioFinalMVC.Models;

public class Funcionario
{
    public int Id { get; set; }
    public string Nome { get; set; } = "";
    public string Cargo { get; set; } = "";
    public string Departamento { get; set; } = "";
    public decimal Salario { get; set; }
    public bool Ativo { get; set; }

    public string Status =>
        Ativo ? "Funcionário ativo" : "Funcionário desligado";

    public string Faixa =>
        Salario < 2500 ? "Faixa 1" :
        Salario <= 5000 ? "Faixa 2" :
        "Faixa 3";
}


// ============================================================
// CONTROLLERS/FUNCIONARIOCONTROLLER.CS
// ============================================================

using Microsoft.AspNetCore.Mvc;
using DesafioFinalMVC.Models;

namespace DesafioFinalMVC.Controllers;

public class FuncionarioController : Controller
{
    private List<Funcionario> funcionarios = new()
    {
        new() { Id=1, Nome="Ana", Cargo="Analista", Departamento="TI", Salario=4500, Ativo=true },
        new() { Id=2, Nome="Bruno", Cargo="Gerente", Departamento="RH", Salario=6500, Ativo=true },
        new() { Id=3, Nome="Carlos", Cargo="Assistente", Departamento="Financeiro", Salario=2200, Ativo=false },
        new() { Id=4, Nome="Daniela", Cargo="Programadora", Departamento="TI", Salario=5200, Ativo=true },
        new() { Id=5, Nome="Eduardo", Cargo="Vendedor", Departamento="Comercial", Salario=2800, Ativo=true },
        new() { Id=6, Nome="Fernanda", Cargo="Analista", Departamento="RH", Salario=3900, Ativo=false },
        new() { Id=7, Nome="Gabriel", Cargo="Diretor", Departamento="Diretoria", Salario=9000, Ativo=true },
        new() { Id=8, Nome="Helena", Cargo="Assistente", Departamento="Financeiro", Salario=2300, Ativo=true },
        new() { Id=9, Nome="Igor", Cargo="Programador", Departamento="TI", Salario=4800, Ativo=true },
        new() { Id=10, Nome="Julia", Cargo="Vendedora", Departamento="Comercial", Salario=2600, Ativo=false },
        new() { Id=11, Nome="Lucas", Cargo="Gerente", Departamento="Comercial", Salario=5800, Ativo=true },
        new() { Id=12, Nome="Mariana", Cargo="Analista", Departamento="RH", Salario=4200, Ativo=true },
        new() { Id=13, Nome="Nicolas", Cargo="Assistente", Departamento="Financeiro", Salario=2100, Ativo=false },
        new() { Id=14, Nome="Paula", Cargo="Coordenadora", Departamento="TI", Salario=6200, Ativo=true },
        new() { Id=15, Nome="Rafael", Cargo="Analista", Departamento="Financeiro", Salario=3700, Ativo=true }
    };

    public IActionResult Index() => View(funcionarios);

    public IActionResult Ativos()
        => View("Index", funcionarios.Where(x => x.Ativo));

    public IActionResult Inativos()
        => View("Index", funcionarios.Where(x => !x.Ativo));

    public IActionResult Departamento(string nome = "TI")
        => View("Index", funcionarios.Where(x => x.Departamento == nome));

    public IActionResult Dashboard()
    {
        ViewBag.Total = funcionarios.Count;
        ViewBag.Ativos = funcionarios.Count(x => x.Ativo);
        ViewBag.Inativos = funcionarios.Count(x => !x.Ativo);
        ViewBag.Media = funcionarios.Average(x => x.Salario);
        ViewBag.Maximo = funcionarios.Max(x => x.Salario);
        ViewBag.Minimo = funcionarios.Min(x => x.Salario);

        ViewBag.TI = funcionarios.Count(x => x.Departamento == "TI");
        ViewBag.RH = funcionarios.Count(x => x.Departamento == "RH");
        ViewBag.Financeiro = funcionarios.Count(x => x.Departamento == "Financeiro");
        ViewBag.Comercial = funcionarios.Count(x => x.Departamento == "Comercial");
        ViewBag.Diretoria = funcionarios.Count(x => x.Departamento == "Diretoria");

        return View();
    }
}


