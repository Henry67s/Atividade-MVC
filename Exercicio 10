// ============================================================
// VIEWS/ELETRONICO/INDEX.CSHTML
// ============================================================

@model IEnumerable<EletronicosMVC.Models.Eletronico>

<h1>Loja de Eletrônicos</h1>

<table border="1">
<tr>
    <th>Nome</th>
    <th>Marca</th>
    <th>Categoria</th>
    <th>Preço</th>
    <th>Estoque</th>
    <th>Status</th>
</tr>

@foreach (var p in Model)
{
<tr>
    <td>@p.Nome</td>
    <td>@p.Marca</td>
    <td>@p.Categoria</td>
    <td>R$ @p.Preco.ToString("N2")</td>
    <td>@p.Estoque</td>
    <td>@(p.Estoque > 0 ? "Disponível" : "Produto esgotado")</td>
</tr>
}
</table>


// ============================================================
// VIEWS/ELETRONICO/ESTOQUE.CSHTML
// ============================================================

@model IEnumerable<EletronicosMVC.Models.Eletronico>

<h1>Produtos em Estoque</h1>

@foreach (var p in Model)
{
    <p>@p.Nome - @p.Estoque unidades</p>
}


// ============================================================
// VIEWS/ELETRONICO/CATEGORIA.CSHTML
// ============================================================

@model IEnumerable<EletronicosMVC.Models.Eletronico>

<h1>Produtos da Categoria</h1>

@foreach (var p in Model)
{
    <p>@p.Nome - @p.Categoria - R$ @p.Preco.ToString("N2")</p>
}


// ============================================================
// VIEWS/ELETRONICO/ATE.CSHTML
// ============================================================

@model IEnumerable<EletronicosMVC.Models.Eletronico>

<h1>Produtos até R$ 1.000</h1>

@foreach (var p in Model)
{
    <p>@p.Nome - R$ @p.Preco.ToString("N2")</p>
}
