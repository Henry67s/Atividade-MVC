// ============================================================
// VIEWS/PEDIDO/INDEX.CSHTML
// ============================================================

@model IEnumerable<PedidosMVC.Models.Pedido>

<h1>Pedidos</h1>

<table border="1">
<tr>
    <th>ID</th>
    <th>Cliente</th>
    <th>Produto</th>
    <th>Quantidade</th>
    <th>Preço</th>
    <th>Total</th>
    <th>Status</th>
</tr>

@foreach (var p in Model)
{
<tr>
    <td>@p.Id</td>
    <td>@p.Cliente</td>
    <td>@p.Produto</td>
    <td>@p.Quantidade</td>
    <td>R$ @p.PrecoUnitario.ToString("N2")</td>
    <td>R$ @p.Total.ToString("N2")</td>
    <td>@p.Status</td>
</tr>
}
</table>


// ============================================================
// VIEWS/PEDIDO/RESUMO.CSHTML
// ============================================================

<h1>Dashboard de Pedidos</h1>

<p>Total de pedidos: <strong>@ViewBag.TotalPedidos</strong></p>
<p>Valor total: <strong>R$ @ViewBag.ValorTotal.ToString("N2")</strong></p>

<h2>Por Status</h2>

<p>Recebidos: @ViewBag.Recebidos</p>
<p>Em preparo: @ViewBag.Preparo</p>
<p>Prontos: @ViewBag.Prontos</p>
<p>Entregues: @ViewBag.Entregues</p>
